# Clinic Dial API — server only. Never prefix with NEXT_PUBLIC_.
# Use a Supabase project separate from Lumen.

# Project URL — required for JWKS verify (new Supabase projects sign user JWTs with ES256)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Legacy HS256 JWT secret (Project Settings → API → JWT Secret).
# Still used by local tests / older projects. ES256 sessions verify via JWKS from SUPABASE_URL.
SUPABASE_JWT_SECRET=YOUR_SECRET

# Optional: service-role key if wiring live DB later (never browser)
# SUPABASE_SERVICE_ROLE_KEY=

# CORS origins for the dashboard + voice client
LALA_CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://127.0.0.1:3001,http://127.0.0.1:3002

# Default clinic timezone when omitted on create
LALA_DEFAULT_TIMEZONE=Asia/Kolkata

# Pepper for hashing website integration API keys (server only, ≥16 chars)
LALA_INTEGRATION_KEY_PEPPER=replace-with-long-random-pepper

# Optional durable Postgres (Supabase direct connection). Leave empty for in-memory POC/tests.
# DATABASE_URL=postgresql://postgres:password@db.YOUR_REF.supabase.co:5432/postgres

# Google Calendar OAuth (server only). Leave empty to run Clinic Dial-only scheduling.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/calendar/google/callback

# Cal.com — clinic API keys are stored encrypted per clinic; server webhook secret verifies inbound hooks.
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# Pepper for visitor session tokens (falls back to LALA_INTEGRATION_KEY_PEPPER when empty)
# LALA_VISITOR_SESSION_SECRET=

# Epic 7 — voice transcript retention window (D01). Default 90 days.
LALA_VOICE_RETENTION_DAYS=90

# --- Epic 6 voice (server only). Leave empty to run mock pipeline. ---
# Gnani Speech — https://app.gnani.ai/  (maps to X-API-Key-ID)
GNANI_API_KEY=
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE_EN=Kaveri
GNANI_TTS_VOICE_HI=Nalini
GNANI_TTS_VOICE_TE=Kaveri

# Receptionist brain — OpenRouter (recommended; no GPU). Same fields work for OpenAI/Evon.
# Speech stays on Gnani (STT/TTS above). Full live = Gnani + these LLM_* vars.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
# Optional alias if you prefer this name (used when LLM_API_KEY is empty):
OPENROUTER_API_KEY=
# Optional self-hosted Evon instead:
# LLM_BASE_URL=https://your-gpu-host
# LLM_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# HF_TOKEN belongs on the GPU host only — never here.
EVON_HF_REPO_ID=gnani/gnani-evon-v3.3-30B-A3B
