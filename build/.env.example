# Copy to .env and fill before building / deploying.
# Public browser URLs (also baked into the dashboard image at build time).

HTTP_PORT=80

LUMEN_HOST=lumen.localhost
DASHBOARD_HOST=app.localhost
VOICE_HOST=voice.localhost
API_HOST=api.localhost

# Must match the public API URL browsers will call (HTTPS in production).
NEXT_PUBLIC_LALA_API_URL=http://api.localhost

# Clinic Dial Supabase (dashboard browser keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_LALA_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LALA_ANON_KEY
